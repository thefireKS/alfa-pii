# Example configuration for pii-service.
#
# All settings are read from the environment. Values shown here are the
# defaults; unset variables keep the defaults. No secrets are stored here.
#
#   PII_LISTEN_ADDR        TCP address to bind, e.g. ":8080"
#   PII_READ_TIMEOUT       server read timeout, e.g. "10s"
#   PII_WRITE_TIMEOUT      server write timeout, e.g. "10s"
#   PII_IDLE_TIMEOUT       keep-alive idle timeout, e.g. "60s"
#   PII_SHUTDOWN_TIMEOUT   graceful shutdown budget, e.g. "10s"
#   PII_MAX_BODY_BYTES     max request body size in bytes, e.g. "1048576"
#   PII_MAX_ACTIVE_REQUESTS max concurrent in-flight requests, e.g. "200"
#   PII_STORE_MAX_ENTRIES  max stored correspondences, e.g. "100000"
#   PII_STORE_MAX_BYTES    max total bytes held by the store, e.g. "67108864"
#   PII_STORE_MAX_RECORD_BYTES max estimated bytes of one correspondence, e.g. "1048576"
#   PII_STORE_TTL          correspondence lifetime, e.g. "24h"
#   PII_STORE_CREATE_WAIT  max wait for another request creating the same key, e.g. "5s"
#   PII_STORE_CLEANUP_INTERVAL background eviction interval, e.g. "1m"
#   PII_MARKER_PREFIX      prefix for replacement markers, e.g. "PII"